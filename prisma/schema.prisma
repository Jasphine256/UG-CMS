generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ===================== ENUMS =====================

enum UserStatus {
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum CaseType {
  CRIMINAL
  CIVIL
  FAMILY
  LAND
  COMMERCIAL
  ANTI_CORRUPTION
}

enum CaseStatus {
  REPORTED
  UNDER_INVESTIGATION
  DPP_REVIEW
  FILED_IN_COURT
  ACTIVE
  ADJOURNED
  COMMITTED_FOR_TRIAL
  ON_TRIAL
  PENDING_JUDGMENT
  JUDGMENT_DELIVERED
  CLOSED
  DISMISSED
  WITHDRAWN
  TRANSFERRED
  ON_APPEAL
}

enum CourtLevel {
  SUPREME
  COURT_OF_APPEAL
  HIGH_COURT
  CHIEF_MAGISTRATE
  MAGISTRATE_GRADE_I
  MAGISTRATE_GRADE_II
  LC_III
  LC_II
  LC_I
}

enum HighCourtDivision {
  CIVIL
  CRIMINAL
  COMMERCIAL
  FAMILY
  LAND
  ANTI_CORRUPTION
  INTERNATIONAL_CRIMES
}

enum HearingType {
  FIRST_MENTION
  PLEA_TAKING
  BAIL_HEARING
  CASE_MANAGEMENT_CONFERENCE
  COMMITTAL
  PRE_TRIAL
  TRIAL
  VERDICT
  SENTENCING
  JUDGMENT
  APPEAL_HEARING
  REVIEW
  MENTION
  STATUS_CONFERENCE
}

enum PartyType {
  COMPLAINANT
  VICTIM
  ACCUSED
  DEFENDANT
  APPLICANT
  RESPONDENT
  WITNESS
  SURETY
  PROSECUTOR
  DEFENCE_COUNSEL
  THIRD_PARTY
  INTERESTED_PARTY
}

enum EvidenceType {
  DOCUMENT
  PHYSICAL_EXHIBIT
  DIGITAL
  TESTIMONY
  PHOTOGRAPH
  VIDEO
  FORENSIC
  OTHER
}

enum EvidenceStatus {
  IN_CUSTODY
  SUBMITTED_TO_COURT
  ADMITTED
  RETURNED
  DESTROYED
  LOST
}

enum BailDecision {
  GRANTED
  DENIED
  DEFERRED
  REVOKED
}

enum AppealType {
  FIRST_APPEAL
  SECOND_APPEAL
  CONSTITUTIONAL
}

enum AppealOutcome {
  ALLOWED
  DISMISSED
  VARY_SENTENCE
  REMAND_FOR_RETRIAL
  PARTIALLY_ALLOWED
  STRUCK_OUT
}

enum DetentionStatus {
  REMAND
  SENTENCED
  BAILED
  TRANSFERRED
  RELEASED
  ESCAPED
}

enum NotificationChannel {
  EMAIL
  SMS
  IN_APP
  SYSTEM
}

enum PermissionAction {
  CREATE
  READ
  UPDATE
  DELETE
  APPROVE
  REJECT
  ASSIGN
  TRANSFER
  ARCHIVE
  EXPORT
}

enum ResourceType {
  CASE
  USER
  ROLE
  COURT
  HEARING
  EVIDENCE
  DOCUMENT
  BAIL_APPLICATION
  APPEAL
  DETENTION
  INVESTIGATION
  NOTIFICATION
  AUDIT_LOG
  REPORT
  SETTINGS
}

// ===================== USER & RBAC DOMAIN =====================

model User {
  id            String           @id @default(cuid())
  email         String           @unique
  passwordHash  String
  firstName     String
  lastName      String
  otherNames    String?
  phoneNumber   String?
  nationalId    String?          @unique
  barNumber     String?
  badgeNumber   String?
  jobTitle      String?
  status        UserStatus       @default(ACTIVE)
  isVerified    Boolean          @default(false)
  lastLoginAt   DateTime?
  avatarUrl     String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  roles                UserRole[]
  assignedCases        Case[]              @relation("AssignedJudge")
  createdCases         Case[]              @relation("CreatedByUser")
  caseParties          CaseParty[]
  evidenceChainFrom    EvidenceChain[]     @relation("ChainFrom")
  evidenceChainTo      EvidenceChain[]     @relation("ChainTo")
  notifications        Notification[]
  auditLogs            AuditLog[]
  bailApplications     BailApplication[]   @relation("BailApplicant")
  sureties             Surety[]
  documentUploads      Document[]
  investigations       Investigation[]    @relation("Investigator")
  courtSessions        CourtSession[]
  hearings             Hearing[]
  suretyVerifications  Surety[]           @relation("SuretyVerifier")
  supervisedInvestigations Investigation[] @relation("Supervisor")
  lawyerCases          CaseParty[]        @relation("PartyLawyer")
  caseTimelines        CaseTimeline[]

  @@map("users")
}

model Role {
  id          String           @id @default(cuid())
  name        String           @unique
  slug        String           @unique
  description String?
  hierarchy   Int
  isSystem    Boolean          @default(false)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  users       UserRole[]
  permissions RolePermission[]

  @@map("roles")
}

model UserRole {
  id         String   @id @default(cuid())
  userId     String
  roleId     String
  courtId    String?
  assignedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Restrict)
  court Court? @relation(fields: [courtId], references: [id], onDelete: SetNull)

  @@unique([userId, roleId, courtId])
  @@map("user_roles")
}

model Permission {
  id          String           @id @default(cuid())
  resource    ResourceType
  action      PermissionAction
  conditions  Json?
  description String?
  createdAt   DateTime         @default(now())

  roles RolePermission[]

  @@unique([resource, action])
  @@map("permissions")
}

model RolePermission {
  id           String     @id @default(cuid())
  roleId       String
  permissionId String

  role     Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

// ===================== ORGANIZATION DOMAIN =====================

model Court {
  id           String             @id @default(cuid())
  name         String
  code         String             @unique
  level        CourtLevel
  division     HighCourtDivision?
  location     String
  address      String?
  contactPhone String?
  contactEmail String?
  isActive     Boolean            @default(true)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  parentCourtId String?
  parentCourt   Court?            @relation("CourtHierarchy", fields: [parentCourtId], references: [id])
  subCourts     Court[]           @relation("CourtHierarchy")

  cases          Case[]
  courtSessions  CourtSession[]
  hearings       Hearing[]
  userRoles      UserRole[]
  appeals        Appeal[]
  policeStations PoliceStation[]

  @@map("courts")
}

model PoliceStation {
  id           String          @id @default(cuid())
  name         String
  code         String          @unique
  location     String
  address      String?
  contactPhone String?
  contactEmail String?
  isActive     Boolean         @default(true)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  courtId        String?
  court          Court?            @relation(fields: [courtId], references: [id])
  investigations Investigation[]

  @@map("police_stations")
}

// ===================== CASE MANAGEMENT DOMAIN =====================

model Case {
  id              String     @id @default(cuid())
  caseNumber      String     @unique
  caseType        CaseType
  caseStatus      CaseStatus @default(REPORTED)
  title           String
  description     String?    @db.Text
  filingDate      DateTime
  courtId         String
  court           Court      @relation(fields: [courtId], references: [id])
  assignedJudgeId String?
  assignedJudge   User?      @relation("AssignedJudge", fields: [assignedJudgeId], references: [id])
  createdById     String
  createdBy       User       @relation("CreatedByUser", fields: [createdById], references: [id])
  isSensitive     Boolean    @default(false)
  caseFee         Decimal?   @db.Decimal(12, 2)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  criminalDetails   CriminalCaseDetails?
  civilDetails      CivilCaseDetails?
  parties           CaseParty[]
  hearings          Hearing[]
  timelines         CaseTimeline[]
  documents         Document[]
  evidence          Evidence[]
  bailApplications  BailApplication[]
  appeals           Appeal[]
  detentionRecords  DetentionRecord[]
  investigations    Investigation[]

  @@index([caseStatus])
  @@index([caseType])
  @@index([courtId])
  @@index([assignedJudgeId])
  @@index([filingDate])
  @@map("cases")
}

model CriminalCaseDetails {
  id                   String    @id @default(cuid())
  caseId               String    @unique
  case                 Case      @relation(fields: [caseId], references: [id], onDelete: Cascade)
  offenceType          String
  offenceDescription   String?   @db.Text
  penalCodeSection     String?
  arrestDate           DateTime?
  arrestWarrantNumber  String?
  chargeSheetNumber    String?
  isBailable           Boolean?
  dppReferenceNumber   String?
  dppSanctionDate      DateTime?
  committalDate        DateTime?
  pleaBargainIndicated Boolean   @default(false)
  pleaBargainDetails   String?   @db.Text
  previousConvictions  String?   @db.Text
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@map("criminal_case_details")
}

model CivilCaseDetails {
  id                    String    @id @default(cuid())
  caseId                String    @unique
  case                  Case      @relation(fields: [caseId], references: [id], onDelete: Cascade)
  claimAmount           Decimal?  @db.Decimal(15, 2)
  causeOfAction         String?   @db.Text
  noticeOfIntentionDate DateTime?
  plaintFiledDate       DateTime?
  defenceFiledDate      DateTime?
  replyFiledDate        DateTime?
  cmcDate               DateTime?
  isUrgent              Boolean   @default(false)
  natureOfDispute       String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("civil_case_details")
}

model CaseParty {
  id         String    @id @default(cuid())
  caseId     String
  case       Case      @relation(fields: [caseId], references: [id], onDelete: Cascade)
  userId     String?
  user       User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  partyType  PartyType
  firstName  String
  lastName   String
  otherNames String?
  nationalId String?
  phoneNumber String?
  email      String?
  address    String?
  isMinor    Boolean   @default(false)
  representation String? @default("SELF")
  lawyerId   String?
  lawyer     User?     @relation("PartyLawyer", fields: [lawyerId], references: [id])
  isActive   Boolean   @default(true)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([caseId, userId, partyType])
  @@map("case_parties")
}

model CaseTimeline {
  id          String   @id @default(cuid())
  caseId      String
  case        Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  eventType   String
  title       String
  description String?  @db.Text
  eventDate   DateTime
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([caseId, eventDate])
  @@map("case_timelines")
}

// ===================== COURT OPERATIONS DOMAIN =====================

model CourtSession {
  id               String    @id @default(cuid())
  courtId          String
  court            Court     @relation(fields: [courtId], references: [id])
  name             String
  startDate        DateTime
  endDate          DateTime
  sessionType      String    @default("CRIMINAL_SESSION")
  status           String    @default("SCHEDULED")
  presidingJudgeId String?
  presidingJudge   User?     @relation(fields: [presidingJudgeId], references: [id])
  notes            String?   @db.Text
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  hearings Hearing[]

  @@index([courtId, startDate])
  @@map("court_sessions")
}

model Hearing {
  id               String      @id @default(cuid())
  caseId           String
  case             Case        @relation(fields: [caseId], references: [id], onDelete: Cascade)
  courtSessionId   String?
  courtSession     CourtSession? @relation(fields: [courtSessionId], references: [id])
  courtId          String
  court            Court       @relation(fields: [courtId], references: [id])
  hearingType      HearingType
  hearingDate      DateTime
  startTime        DateTime?
  endTime          DateTime?
  duration         Int?
  outcome          String?     @db.Text
  notes            String?     @db.Text
  isAdjourned      Boolean     @default(false)
  adjournmentDate  DateTime?
  adjournmentReason String?
  nextHearingDate  DateTime?
  createdById      String
  createdBy        User        @relation(fields: [createdById], references: [id])
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  @@index([hearingDate])
  @@index([courtId, hearingDate])
  @@index([caseId])
  @@map("hearings")
}

// ===================== INVESTIGATION & EVIDENCE DOMAIN =====================

model Investigation {
  id                    String         @id @default(cuid())
  caseId                String?
  case                  Case?          @relation(fields: [caseId], references: [id], onDelete: SetNull)
  policeStationId       String
  policeStation         PoliceStation  @relation(fields: [policeStationId], references: [id])
  assignedOfficerId     String
  assignedOfficer       User           @relation("Investigator", fields: [assignedOfficerId], references: [id])
  supervisingOfficerId  String?
  supervisingOfficer    User?          @relation("Supervisor", fields: [supervisingOfficerId], references: [id])
  pgiProsecutorId       String?
  startDate             DateTime
  completionDate        DateTime?
  status                String         @default("ACTIVE")
  closureReportRef      String?
  findings              String?        @db.Text
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  evidence Evidence[]

  @@index([status])
  @@map("investigations")
}

model Evidence {
  id              String         @id @default(cuid())
  caseId          String
  case            Case           @relation(fields: [caseId], references: [id], onDelete: Cascade)
  investigationId String?
  investigation   Investigation? @relation(fields: [investigationId], references: [id])
  exhibitNumber   String
  description     String         @db.Text
  evidenceType    EvidenceType
  status          EvidenceStatus @default(IN_CUSTODY)
  location        String?
  collectedBy     String?
  collectedDate   DateTime?
  admittedDate    DateTime?
  admittedBy      String?
  returnDate      DateTime?
  isConfidential  Boolean        @default(false)
  fileUrl         String?
  fileHash        String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  custodyChain EvidenceChain[]

  @@index([caseId])
  @@map("evidence")
}

model EvidenceChain {
  id            String   @id @default(cuid())
  evidenceId    String
  evidence      Evidence @relation(fields: [evidenceId], references: [id], onDelete: Cascade)
  fromUserId    String
  fromUser      User     @relation("ChainFrom", fields: [fromUserId], references: [id])
  toUserId      String
  toUser        User     @relation("ChainTo", fields: [toUserId], references: [id])
  transferDate  DateTime @default(now())
  purpose       String
  notes         String?  @db.Text
  signatureFrom String?
  signatureTo   String?

  @@map("evidence_chains")
}

// ===================== BAIL & SURETY DOMAIN =====================

model BailApplication {
  id              String       @id @default(cuid())
  caseId          String
  case            Case         @relation(fields: [caseId], references: [id], onDelete: Cascade)
  applicantId     String
  applicant       User         @relation("BailApplicant", fields: [applicantId], references: [id])
  filingDate      DateTime
  hearingDate     DateTime?
  decisionDate    DateTime?
  decision        BailDecision?
  decisionReason  String?      @db.Text
  bailAmount      Decimal?     @db.Decimal(15, 2)
  conditions      String?      @db.Text
  isCashBail      Boolean      @default(false)
  decidedBy       String?
  bondSignedDate  DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  sureties Surety[]

  @@index([caseId])
  @@map("bail_applications")
}

model Surety {
  id                    String          @id @default(cuid())
  bailApplicationId     String
  bailApplication       BailApplication @relation(fields: [bailApplicationId], references: [id], onDelete: Cascade)
  userId                String?
  user                  User?           @relation(fields: [userId], references: [id])
  fullName              String
  nationalId            String
  occupation            String?
  address               String?
  phoneNumber           String?
  relationshipToAccused String?
  bondAmount            Decimal?        @db.Decimal(15, 2)
  verificationStatus    String          @default("PENDING")
  verificationNotes     String?         @db.Text
  verifiedById          String
  verifiedBy            User            @relation("SuretyVerifier", fields: [verifiedById], references: [id])
  verifiedDate          DateTime?
  identificationDoc     String?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  @@map("sureties")
}

// ===================== APPEAL DOMAIN =====================

model Appeal {
  id                String    @id @default(cuid())
  originalCaseId    String
  originalCase      Case      @relation(fields: [originalCaseId], references: [id])
  appellantId       String
  respondentId      String
  appealType        AppealType
  appealNumber      String    @unique
  filingDate        DateTime
  groundsOfAppeal   String    @db.Text
  reliefSought      String    @db.Text
  status            String    @default("FILED")
  assignedCourtId   String
  assignedCourt     Court     @relation(fields: [assignedCourtId], references: [id])
  assignedJudgeId   String?
  recordOfAppealUrl String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  decisions AppealDecision[]

  @@index([originalCaseId])
  @@map("appeals")
}

model AppealDecision {
  id                   String        @id @default(cuid())
  appealId             String
  appeal               Appeal        @relation(fields: [appealId], references: [id], onDelete: Cascade)
  decisionDate         DateTime
  outcome              AppealOutcome
  reasoning            String        @db.Text
  orderDetails         String?       @db.Text
  decidedBy            String?
  isFinal              Boolean       @default(true)
  rightToFurtherAppeal Boolean       @default(false)
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  @@map("appeal_decisions")
}

// ===================== DOCUMENT MANAGEMENT DOMAIN =====================

model Document {
  id              String   @id @default(cuid())
  caseId          String?
  case            Case?    @relation(fields: [caseId], references: [id], onDelete: Cascade)
  appealId        String?
  documentType    String
  title           String
  description     String?  @db.Text
  fileName        String
  fileUrl         String
  fileSize        Int
  mimeType        String
  isConfidential  Boolean  @default(false)
  accessLevel     String   @default("PARTIES_ONLY")
  uploadedById    String
  uploadedBy      User     @relation(fields: [uploadedById], references: [id])
  version         Int      @default(1)
  parentDocId     String?
  signatureHash   String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tags DocumentTag[]

  @@index([caseId])
  @@map("documents")
}

model DocumentTag {
  id         String   @id @default(cuid())
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  tag        String

  @@unique([documentId, tag])
  @@map("document_tags")
}

// ===================== DETENTION DOMAIN =====================

model DetentionRecord {
  id                  String          @id @default(cuid())
  personId            String
  caseId              String
  case                Case            @relation(fields: [caseId], references: [id])
  facilityName        String
  admissionDate       DateTime
  expectedReleaseDate DateTime?
  actualReleaseDate   DateTime?
  status              DetentionStatus @default(REMAND)
  warrantNumber       String?
  warrantType         String?
  bailApplicationId   String?
  courtOrderNumber    String?
  releaseReason       String?
  notes               String?         @db.Text
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  transfers PrisonTransfer[]

  @@index([personId])
  @@index([caseId])
  @@map("detention_records")
}

model PrisonTransfer {
  id                String          @id @default(cuid())
  detentionRecordId String
  detentionRecord   DetentionRecord @relation(fields: [detentionRecordId], references: [id], onDelete: Cascade)
  fromFacility      String
  toFacility        String
  transferDate      DateTime
  reason            String?         @db.Text
  authorizedById    String
  courtOrderRef     String?
  completed         Boolean         @default(false)
  createdAt         DateTime        @default(now())

  @@map("prison_transfers")
}

// ===================== NOTIFICATION DOMAIN =====================

model Notification {
  id            String              @id @default(cuid())
  userId        String
  user          User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel       NotificationChannel @default(IN_APP)
  type          String
  title         String
  body          String?             @db.Text
  referenceId   String?
  referenceType String?
  isRead        Boolean             @default(false)
  sentAt        DateTime            @default(now())
  readAt        DateTime?
  deliveredAt   DateTime?
  error         String?             @db.Text

  @@index([userId, isRead])
  @@index([userId, sentAt])
  @@map("notifications")
}

model NotificationPreference {
  id              String  @id @default(cuid())
  userId          String  @unique
  emailEnabled    Boolean @default(true)
  smsEnabled      Boolean @default(true)
  inAppEnabled    Boolean @default(true)
  digestEnabled   Boolean @default(false)
  quietHoursStart String?
  quietHoursEnd   String?

  @@map("notification_preferences")
}

// ===================== AUDIT DOMAIN =====================

model AuditLog {
  id         String       @id @default(cuid())
  userId     String?
  user       User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String
  resource   ResourceType
  resourceId String?
  oldValue   Json?
  newValue   Json?
  ipAddress  String?
  userAgent  String?
  metadata   Json?
  createdAt  DateTime     @default(now())

  @@index([resource, resourceId])
  @@index([userId])
  @@index([createdAt])
  @@map("audit_logs")
}
